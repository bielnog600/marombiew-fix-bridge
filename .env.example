# --- Corretora (cTrader FIX, sessão QUOTE = só preços) ---
FIX_HOST=live.cfixapi.com
FIX_PORT=5211
FIX_TLS=true
FIX_SENDER_COMP_ID=live5.icmarkets.9010569
FIX_TARGET_COMP_ID=cServer

FIX_USERNAME=9010569
FIX_PASSWORD=coloque_a_senha_da_conta_aqui

# Pares (formato do app). IDs são descobertos sozinhos pela lista da corretora.
SYMBOLS=EUR/USD,GBP/USD,USD/JPY,XAU/USD
# Opcional, só se algum par não for encontrado: {"EUR/USD":"1"}
SYMBOL_IDS=

# bid (igual ao gráfico do cTrader), ask ou mid
PRICE_SIDE=bid

# --- Marombiew FX ---
INGEST_URL=https://SEU-APP.lovable.app/api/public/fix/ingest
INGEST_TOKEN=mesmo_valor_do_secret_FIX_INGEST_TOKEN_no_lovable
PUSH_EVERY_MS=10000
DEBUG_FIX=false

# --- Ordens (sessão TRADE). Desligado por padrão. ---
# Só ligue depois que o app tiver os botões e a fila de comandos.
TRADE_ENABLED=false
# openapi (padrão: stop/alvo presos na posição) ou fix
TRADE_VIA=openapi
FIX_TRADE_PORT=5212
# Travas da própria ponte (valem mesmo se o app mandar algo errado)
MAX_LOTS_PER_ORDER=0.10
MAX_OPEN_POSITIONS=3
